{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuika",
  "version": "0.1.0",
  "identifier": "com.zamizzudin.yuika",
  "build": {
    "beforeDevCommand": "npm run dev -w @yuika/web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../apps/web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yuika",
        "url": "welcome.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
