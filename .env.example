# --- Provider (D12: kunci langsung, OpenAI-compatible saja untuk demo) ---
YUI_OPENAI_BASE_URL=https://api.openai.com/v1
# P1-INF-2 jenis provider: openai-compat (default) | anthropic | gemini — juga diatur di Settings → Provider
# YUI_PROVIDER_KIND=openai-compat
YUI_OPENAI_API_KEY=sk-xxx
YUI_MODEL=gpt-4o
YUI_MODEL_FALLBACK=

# --- Paths (opsional; default relatif ke repo root) ---
YUI_DB_PATH=
YUI_WORKSPACE_DIR=
YUI_PERSONAS_DIR=
YUI_SKILLS_DIR=
YUI_MCP_CONFIG=./mcp.json

# --- Keamanan & kebijakan ---
# P0-SEC-4: deadline approval sebelum auto-deny (fail-closed), dalam ms.
# Default 300000 (5 menit); 0 = nonaktif (khusus test).
YUI_APPROVAL_TIMEOUT_MS=300000

# ── Kompresi konteks (P0-CORE-4) ──
# Estimasi jendela konteks model (token) — acuan kapan kompresi jalan.
YUI_CONTEXT_TOKENS=128000
# Pemicu kompresi: persen dari jendela (700 = 70%).
YUI_COMPRESS_THRESHOLD_PCT=700
# Berapa pesan TERBARU yang selalu utuh (tidak diringkas).
YUI_COMPRESS_KEEP_RECENT=6
# Minimal jumlah pesan sebelum sesi layak dikompresi.
YUI_COMPRESS_MIN_MESSAGES=10

# --- Loop & provider (fix 2026-11) ---
# Budget iterasi tool-round per turn (mode normal / Safety).
YUI_MAX_ITER=16
# Cap iterasi saat mode Hardcore (auto-approve): selesaikan sampai tuntas.
YUI_MAX_ITER_HARDCORE=64
# Timeout per panggilan provider (ms). Default 300000 (5 mnt) — model reasoning
# dengan konteks MCP besar bisa >120 dtk sampai token pertama ("Socket timeout").
YUI_PROVIDER_TIMEOUT_MS=300000
