# --- Provider (D12: kunci langsung, OpenAI-compatible saja untuk demo) ---
YUI_OPENAI_BASE_URL=https://api.openai.com/v1
# P1-INF-2 jenis provider: openai-compat (default) | anthropic | gemini — juga diatur di Settings → Provider
# YUI_PROVIDER_KIND=openai-compat
YUI_OPENAI_API_KEY=sk-xxx
YUI_MODEL=gpt-4o
YUI_MODEL_FALLBACK=
# P0-CORE-4: model aux murah untuk tugas ringan (kompresi konteks, learn nudge).
# Kosong = pakai model utama. Bisa di-swap panas via Settings → Provider.
YUI_AUX_MODEL=

# --- Paths (opsional; default relatif ke repo root) ---
YUI_DB_PATH=
YUI_WORKSPACE_DIR=
YUI_PERSONAS_DIR=
YUI_SKILLS_DIR=
YUI_MCP_CONFIG=./mcp.json

# --- Retention & housekeeping (P0-DATA-2) ---
# Events sesi dingin (tanpa aktivitas) lebih tua dari N hari dipindahkan ke tabel
# events_archive — semua replay/growth tetap membaca arsip (UNION), identitas id
# tidak berubah. 0 = mati. Trigger: boot + harian + POST /api/settings/housekeeping.
YUI_EVENTS_RETENTION_DAYS=30

# --- Keamanan & kebijakan ---
# P0-SEC-4: deadline approval sebelum auto-deny (fail-closed), dalam ms.
# Default 300000 (5 menit); 0 = nonaktif (khusus test).
YUI_APPROVAL_TIMEOUT_MS=300000

# ── Kompresi konteks (P0-CORE-4) ──
# Estimasi jendela konteks model (token) — acuan kapan kompresi jalan.
YUI_CONTEXT_TOKENS=128000
# Pemicu kompresi: persen dari jendela (700 = 70%).
YUI_COMPRESS_THRESHOLD_PCT=700
# Berapa pesan TERBARU yang selalu utuh (tidak diringkas).
YUI_COMPRESS_KEEP_RECENT=6
# Minimal jumlah pesan sebelum sesi layak dikompresi.
YUI_COMPRESS_MIN_MESSAGES=10

# --- Loop & provider (fix 2026-11) ---
# Budget iterasi tool-round per turn (mode normal / Safety).
YUI_MAX_ITER=16
# Cap iterasi saat mode Hardcore (auto-approve): selesaikan sampai tuntas.
YUI_MAX_ITER_HARDCORE=64
# Timeout per panggilan provider (ms). Default 300000 (5 mnt) — model reasoning
# dengan konteks MCP besar bisa >120 dtk sampai token pertama ("Socket timeout").
YUI_PROVIDER_TIMEOUT_MS=300000

# --- Observability (P0-INF-3) ---
# Level log: trace|debug|info|warn|error|fatal. Kosong = otomatis: "debug" saat
# YUI_TRACE aktif, selain itu "info" (di test: "warn").
# YUI_LOG_LEVEL=
# Format log: 1 (default) = baris pretty `YUI HH:MM:SS.mmm [mod] msg key=val …`
# (struktur stabil — find "[mod]" / "msg" / "ses=xxxx" / "ERROR" untuk tracing);
# 0 = JSON-lines pino (dipakai docker-compose: agregator log grep per field).
# YUI_LOG_PRETTY=1
# Trace durasi loop (turn/iter/tool/approval) ke log — 0 untuk matikan.
YUI_TRACE=1

# --- API service (P0-INF-1) ---
# apps/api (Fastify) = pemilik runtime, terpisah dari Next. Web memanggil via base ini.
# Port api (default 3211); host bind (default 127.0.0.1 — app lokal).
# YUI_API_PORT=3211
# YUI_API_HOST=127.0.0.1
# Base URL yang dipakai FRONTEND (di-inline saat build web). Default
# http://127.0.0.1:3211; di balik reverse proxy same-origin bisa dikosongkan.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:3211

# --- Database driver (P0-DATA-1) ---
# Driver penyimpanan SESSION (sessions/messages/events/approvals/delegation):
#   sqlite   — default; embedded (better-sqlite3), zero-config, ideal desktop/dev
#   postgres — server (multi-worker, skala events besar); butuh DATABASE_URL.
# Skema PG dibuat otomatis saat api start. Pindah data lama:
#   npx tsx scripts/migrate-sqlite-to-pg.mjs --from data/yui.db --to $DATABASE_URL
# Catatan v1: store project/memory/skills tetap SQLite di workspace (menyusul).
# YUI_DB_DRIVER=sqlite
# DATABASE_URL=postgres://yui:yui@127.0.0.1:5545/yui
